{
    "name": "nitro/nitro",
    "description": "Nitro: Livewire-style components (a PHP class and a Blade view) compiled to JavaScript that runs in the browser. Works on Laravel.",
    "keywords": ["nitro", "laravel", "nitro", "components", "reactive", "transpiler"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Zeeshan Ali",
            "homepage": "https://github.com/ZeeshanX4",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "nikic/php-parser": "^5.6"
    },
    "require-dev": {
        "livewire/livewire": "^4.4",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Nitro\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nitro\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nitro\\NitroServiceProvider"
            ],
            "aliases": {
                "Nitro": "Nitro\\Facades\\Nitro"
            }
        }
    },
    "scripts": {
        "test": "@php vendor/phpunit/phpunit/phpunit --colors=always",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "fuzz": "@php tests/Fuzz/fuzz.php",
        "fuzz:all": "@php tests/Fuzz/all.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
